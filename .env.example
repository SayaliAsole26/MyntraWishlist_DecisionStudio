# Copy to .env — never commit .env
# Groq: https://console.groq.com  (optional — deterministic fallbacks work without it)

GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_QUALITY=openai/gpt-oss-120b

# Backend / Railway
# SQLITE path (default: backend/app.db). On Railway with a volume: /data/app.db
# DATABASE_PATH=/data/app.db

# Comma-separated CORS origins — add your Vercel production URL after deploy
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vercel) — set in Vercel dashboard, NOT here:
# VITE_API_URL=https://your-api.up.railway.app
# See Docs/DeploymentPlan.md
